# ---- Database ----
DATABASE_URL="postgresql://clientos:clientos_dev_password@localhost:5433/clientos_dev?schema=public"

# ---- API ----
API_PORT=9004
SESSION_SECRET="replace-with-a-long-random-value-in-every-environment"
SESSION_COOKIE_NAME="clientos_session"
WEB_APP_URL="http://localhost:9003"
NODE_ENV="development"

# ---- Web ----
NEXT_PUBLIC_API_URL="http://localhost:9004/api/v1"

# ---- File storage ----
# Local-disk StorageProvider (dev/single-instance only — see
# docs/architecture.md "Known gaps"). An S3-compatible provider behind the
# same interface is the production upgrade; not yet built.
LOCAL_STORAGE_DIR="./.data/uploads"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Redis / queue (Phase 5 — not yet wired) ----
REDIS_URL=""

# ---- Email ----
# Leave SMTP_HOST unset to use the console/log EmailProvider (logs the email
# and records it in the EmailLog table instead of actually sending it) —
# the default in every environment that hasn't configured real SMTP
# credentials, including this one. Set SMTP_HOST to send for real.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="ClientOS <notifications@example.com>"
