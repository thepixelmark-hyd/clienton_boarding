// ClientOS database schema.
// See /docs/database.md for conventions (cuid ids, soft delete, tenancy,
// optimistic concurrency, audit logging) and the rationale behind them.
//
// Tenancy note: every tenant-scoped model carries an indexed `organizationId`
// column used by the API's TenantScopedRepository for query filtering. Only
// the models directly owned by Organization (Membership, Invitation, Team,
// Client, Project, Form, Notification, AuditLog) declare a formal Prisma
// relation + cascade to Organization; deeper models (Task, Deliverable,
// Asset, Comment, ...) cascade transitively through their parent (Project,
// Client, Form, Deliverable) rather than each declaring a second, redundant
// FK relation directly to Organization. This keeps the graph readable while
// preserving both correct cascade-delete behavior and the ability to filter
// any table directly by organizationId without a join.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization / identity / membership
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  timezone  String    @default("UTC")
  currency  String    @default("INR")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  invitations Invitation[]
  teams       Team[]
  clients     Client[]
  projects    Project[]
  forms       Form[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  memberships        Membership[]
  sessions           Session[]
  invitationsSent    Invitation[]
  projectMemberships ProjectMember[]
  teamMemberships    TeamMember[]
  assignedTasks      Task[]          @relation("TaskAssignee")
  comments           Comment[]
  timeEntries        TimeEntry[]
  notifications      Notification[]
  auditLogs          AuditLog[]      @relation("AuditActor")
  approvalsDecided   Approval[]      @relation("ApprovalDecidedBy")

  @@map("users")
}

enum OrgRole {
  OWNER
  ADMIN
  OPERATIONS_MANAGER
  PROJECT_MANAGER
  ACCOUNT_MANAGER
  TEAM_LEAD
  EMPLOYEE
  CONTRACTOR
  FINANCE
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// Client CRM
// ---------------------------------------------------------------------------

enum ClientStatus {
  PROSPECT
  ACTIVE
  PAUSED
  OFFBOARDED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Client {
  id               String           @id @default(cuid())
  organizationId   String
  name             String
  website          String?
  industry         String?
  description      String?
  logoUrl          String?
  timezone         String           @default("UTC")
  status           ClientStatus     @default(ACTIVE)
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  onboardingStep   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  version          Int              @default(1)

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  projects       Project[]
  forms          Form[]
  portalUsers    ClientPortalUser[]
  timelineEvents ClientTimelineEvent[]
  csatResponses  CSAT[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("clients")
}

model Contact {
  id               String    @id @default(cuid())
  organizationId   String
  clientId         String
  fullName         String
  email            String
  phone            String?
  title            String?
  isPrimary        Boolean   @default(false)
  isDecisionMaker  Boolean   @default(false)
  isBillingContact Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  portalUser  ClientPortalUser?

  @@index([clientId])
  @@index([organizationId])
  @@map("contacts")
}

enum ClientPortalRole {
  CLIENT_ADMIN
  CLIENT_MANAGER
  STAKEHOLDER
  APPROVER
  VIEWER
  BILLING_CONTACT
}

model ClientPortalUser {
  id             String           @id @default(cuid())
  organizationId String
  clientId       String
  contactId      String?          @unique
  email          String
  passwordHash   String
  role           ClientPortalRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact  Contact?              @relation(fields: [contactId], references: [id])
  sessions ClientPortalSession[]

  @@unique([clientId, email])
  @@index([organizationId])
  @@map("client_portal_users")
}

model ClientPortalSession {
  id                 String    @id @default(cuid())
  clientPortalUserId String
  tokenHash          String    @unique
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?

  clientPortalUser ClientPortalUser @relation(fields: [clientPortalUserId], references: [id], onDelete: Cascade)

  @@index([clientPortalUserId])
  @@map("client_portal_sessions")
}

model ClientTimelineEvent {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  type           String
  title          String
  description    String?
  occurredAt     DateTime @default(now())
  metadata       Json?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt])
  @@map("client_timeline_events")
}

// ---------------------------------------------------------------------------
// Projects / delivery
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  description    String?
  type           String?
  status         ProjectStatus @default(PLANNING)
  startDate      DateTime?
  targetEndDate  DateTime?
  actualEndDate  DateTime?
  contractValue  Decimal?  @db.Decimal(14, 2)
  budgetHours    Decimal?  @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  version        Int       @default(1)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  phases         ProjectPhase[]
  milestones     Milestone[]
  tasks          Task[]
  deliverables   Deliverable[]
  assets         Asset[]
  forms          Form[]
  comments       Comment[]
  changeRequests ChangeRequest[]
  timeEntries    TimeEntry[]

  @@index([organizationId])
  @@index([clientId])
  @@index([organizationId, status])
  @@map("projects")
}

enum ProjectMemberRole {
  LEAD
  CONTRIBUTOR
  OBSERVER
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(CONTRIBUTOR)
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectPhase {
  id        String    @id @default(cuid())
  projectId String
  name      String
  order     Int
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([projectId])
  @@map("project_phases")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  phaseId     String?
  name        String
  dueDate     DateTime?
  completedAt DateTime?
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id])
  tasks   Task[]

  @@index([projectId])
  @@map("milestones")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Visibility {
  INTERNAL
  CLIENT_VISIBLE
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  milestoneId    String?
  deliverableId  String?
  parentTaskId   String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  visibility     Visibility   @default(INTERNAL)
  assigneeId     String?
  startDate      DateTime?
  dueDate        DateTime?
  estimatedHours Decimal?     @db.Decimal(8, 2)
  actualHours    Decimal?     @db.Decimal(8, 2)
  billable       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  version        Int          @default(1)

  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone        Milestone?       @relation(fields: [milestoneId], references: [id])
  deliverable      Deliverable?     @relation(fields: [deliverableId], references: [id])
  parentTask       Task?            @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subtasks         Task[]           @relation("TaskSubtasks")
  assignee         User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments         Comment[]
  timeEntries      TimeEntry[]
  dependenciesFrom TaskDependency[] @relation("DependentTask")
  dependenciesTo   TaskDependency[] @relation("BlockingTask")

  @@index([organizationId])
  @@index([projectId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model TaskDependency {
  id              String @id @default(cuid())
  dependentTaskId String
  blockingTaskId  String

  dependentTask Task @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  blockingTask  Task @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, blockingTaskId])
  @@map("task_dependencies")
}

enum DeliverableStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  DELIVERED
}

model Deliverable {
  id                 String            @id @default(cuid())
  organizationId     String
  projectId          String
  name               String
  description        String?
  status             DeliverableStatus @default(NOT_STARTED)
  acceptanceCriteria String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks            Task[]
  requirementLinks DeliverableRequirement[]
  assets           Asset[]
  approvals        Approval[]

  @@index([projectId])
  @@map("deliverables")
}

// The requirement -> deliverable traceability spine (see product.md).
model DeliverableRequirement {
  id            String   @id @default(cuid())
  deliverableId String
  requirementId String
  createdAt     DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, requirementId])
  @@map("deliverable_requirements")
}

// ---------------------------------------------------------------------------
// Requirements engine (forms)
// ---------------------------------------------------------------------------

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  RICH_TEXT
  NUMBER
  CURRENCY
  DATE
  URL
  EMAIL
  PHONE
  SINGLE_SELECT
  MULTI_SELECT
  RATING
  RANKING
  FILE_UPLOAD
  IMAGE_UPLOAD
  VIDEO_UPLOAD
  ADDRESS
  CONSENT
  SIGNATURE
  CALCULATED
}

model Form {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String?
  projectId      String?
  templateKey    String?
  name           String
  description    String?
  isTemplate     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?          @relation(fields: [clientId], references: [id])
  project      Project?         @relation(fields: [projectId], references: [id])
  fields       FormField[]
  submissions  FormSubmission[]

  @@index([organizationId])
  @@map("forms")
}

// `conditionalRule` shape: { "field": "<fieldKey>", "operator": "equals" |
// "notEquals" | "in" | "notIn", "value": <any>, "combine"?: "AND" | "OR",
// "rules"?: ConditionalRule[] } — a small recursive tree evaluated client-
// and server-side by the same function (packages/shared/forms/evaluateRule.ts)
// so branching behaves identically wherever it runs.
model FormField {
  id              String        @id @default(cuid())
  formId          String
  key             String
  label           String
  helpText        String?
  type            FormFieldType
  required        Boolean       @default(false)
  order           Int
  options         Json?
  conditionalRule Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  form      Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  responses FormResponse[]

  @@unique([formId, key])
  @@index([formId])
  @@map("form_fields")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
}

model FormSubmission {
  id                    String           @id @default(cuid())
  formId                String
  organizationId        String
  clientId              String?
  submittedByContactId  String?
  submittedByUserId     String?
  status                SubmissionStatus @default(DRAFT)
  submittedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  form        Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  responses   FormResponse[]
  requirement Requirement?

  @@index([formId])
  @@index([organizationId])
  @@map("form_submissions")
}

// One row per field per submission — the immutable source-of-truth answer.
// A Requirement's `summary` may be edited by staff/AI later; these rows never
// are (see product.md §21/§56).
model FormResponse {
  id           String   @id @default(cuid())
  submissionId String
  fieldId      String
  valueText    String?
  valueJson    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldId])
  @@map("form_responses")
}

enum RequirementReadiness {
  MISSING
  NEEDS_CLARIFICATION
  READY
  CONFLICTING
}

model Requirement {
  id             String                @id @default(cuid())
  organizationId String
  projectId      String?
  submissionId   String                @unique
  title          String
  summary        String?
  readiness      RequirementReadiness  @default(MISSING)
  missingFields  Json?
  conflicts      Json?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  submission       FormSubmission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  deliverableLinks DeliverableRequirement[]

  @@index([organizationId])
  @@index([projectId])
  @@map("requirements")
}

// ---------------------------------------------------------------------------
// Assets, comments, approvals, change requests
// ---------------------------------------------------------------------------

model Asset {
  id             String     @id @default(cuid())
  organizationId String
  projectId      String
  deliverableId  String?
  name           String
  visibility     Visibility @default(INTERNAL)
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id])
  versions    AssetVersion[]

  @@index([projectId])
  @@map("assets")
}

// `storageKey` is an opaque key into the StorageProvider (see architecture.md
// "known gaps" — local-disk in dev, S3-compatible in production). It is never
// served directly; downloads always go through a signed-URL endpoint that
// re-checks authorization for this specific asset/version.
model AssetVersion {
  id            String   @id @default(cuid())
  assetId       String
  versionNumber Int
  label         String?
  storageKey    String
  mimeType      String
  sizeBytes     Int
  uploadedById  String
  createdAt     DateTime @default(now())

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@unique([assetId, versionNumber])
  @@map("asset_versions")
}

model Comment {
  id              String     @id @default(cuid())
  organizationId  String
  authorUserId    String?
  authorContactId String?
  visibility      Visibility @default(INTERNAL)
  body            String
  entityType      String
  entityId        String
  projectId       String?
  taskId          String?
  assetVersionId  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assetVersion AssetVersion? @relation(fields: [assetVersionId], references: [id], onDelete: Cascade)
  author       User?         @relation(fields: [authorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([organizationId])
  @@map("comments")
}

enum ApprovalStatus {
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  APPROVED_WITH_CONDITIONS
  REJECTED
}

// Immutable history: each decision is a new row, never edited (product.md §30).
model Approval {
  id                 String         @id @default(cuid())
  organizationId     String
  deliverableId      String
  version            Int
  status             ApprovalStatus
  decidedById        String?
  decidedByContactId String?
  comments           String?
  createdAt          DateTime       @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  decidedBy   User?       @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([deliverableId])
  @@map("approvals")
}

enum ChangeRequestStatus {
  DRAFT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  APPROVED
  REJECTED
  APPLIED
}

model ChangeRequest {
  id                    String               @id @default(cuid())
  organizationId        String
  projectId             String
  title                 String
  description           String
  reason                String?
  impact                String?
  estimatedEffortHours  Decimal?             @db.Decimal(8, 2)
  estimatedCost         Decimal?             @db.Decimal(12, 2)
  timelineImpactDays    Int?
  status                ChangeRequestStatus  @default(DRAFT)
  requestedById         String?
  requestedByContactId  String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("change_requests")
}

// ---------------------------------------------------------------------------
// Notifications, audit, CSAT, time tracking
// ---------------------------------------------------------------------------

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String?
  entityType     String?
  entityId       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  entityType     String
  entityId       String
  action         String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model CSAT {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  projectId      String?
  rating         Int
  comment        String?
  stage          String
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("csat_responses")
}

model TimeEntry {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  taskId         String?
  userId         String
  minutes        Int
  billable       Boolean  @default(true)
  note           String?
  occurredOn     DateTime
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@map("time_entries")
}
