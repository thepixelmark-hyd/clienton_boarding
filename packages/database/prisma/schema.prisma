// ClientOS database schema.
// See /docs/database.md for conventions (cuid ids, soft delete, tenancy,
// optimistic concurrency, audit logging) and the rationale behind them.
//
// Tenancy note: every tenant-scoped model carries an indexed `organizationId`
// column used by the API's TenantScopedRepository for query filtering. Only
// the models directly owned by Organization (Membership, Invitation, Team,
// Client, Project, Form, Notification, AuditLog) declare a formal Prisma
// relation + cascade to Organization; deeper models (Task, Deliverable,
// Asset, Comment, ...) cascade transitively through their parent (Project,
// Client, Form, Deliverable) rather than each declaring a second, redundant
// FK relation directly to Organization. This keeps the graph readable while
// preserving both correct cascade-delete behavior and the ability to filter
// any table directly by organizationId without a join.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization / identity / membership
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  timezone  String    @default("UTC")
  currency  String    @default("INR")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships      Membership[]
  invitations      Invitation[]
  teams            Team[]
  clients          Client[]
  projects         Project[]
  forms            Form[]
  auditLogs        AuditLog[]
  projectTemplates ProjectTemplate[]

  @@map("organizations")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  memberships           Membership[]
  sessions              Session[]
  invitationsSent       Invitation[]
  clientInvitationsSent ClientInvitation[]
  projectMemberships    ProjectMember[]
  teamMemberships       TeamMember[]
  assignedTasks         Task[]             @relation("TaskAssignee")
  comments              Comment[]
  timeEntries           TimeEntry[]
  notifications         Notification[]
  auditLogs             AuditLog[]         @relation("AuditActor")
  approvalsDecided      Approval[]         @relation("ApprovalDecidedBy")

  @@map("users")
}

enum OrgRole {
  OWNER
  ADMIN
  OPERATIONS_MANAGER
  PROJECT_MANAGER
  ACCOUNT_MANAGER
  TEAM_LEAD
  EMPLOYEE
  CONTRACTOR
  FINANCE
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// Client CRM
// ---------------------------------------------------------------------------

enum ClientStatus {
  PROSPECT
  ACTIVE
  PAUSED
  OFFBOARDED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Client {
  id               String           @id @default(cuid())
  organizationId   String
  name             String
  website          String?
  industry         String?
  description      String?
  // Storage key into the StorageProvider (apps/api/src/storage), not a
  // public URL — served through GET /clients/:id/logo after a tenant check,
  // same "never a public bucket path" rule as Asset (see security.md).
  logoUrl          String?
  timezone         String           @default("UTC")
  status           ClientStatus     @default(ACTIVE)
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  onboardingStep   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  version          Int              @default(1)

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  projects        Project[]
  forms           Form[]
  portalUsers     ClientPortalUser[]
  timelineEvents  ClientTimelineEvent[]
  csatResponses   CSAT[]
  onboardingItems ClientOnboardingItem[]
  invitations     ClientInvitation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("clients")
}

// A stable tag for what this person's stake in the engagement actually is,
// distinct from the three narrower booleans below (a contact can be e.g.
// both the DECISION_MAKER and the BILLING_CONTACT at once — the booleans
// capture that overlap; `role` captures the primary way staff should think
// of them when deciding who to loop in on what).
enum ContactRole {
  DECISION_MAKER
  CHAMPION
  INFLUENCER
  TECHNICAL_CONTACT
  END_USER
  BILLING
  LEGAL
  APPROVER
  OTHER
}

model Contact {
  id               String      @id @default(cuid())
  organizationId   String
  clientId         String
  fullName         String
  email            String
  phone            String?
  title            String?
  role             ContactRole @default(OTHER)
  isPrimary        Boolean     @default(false)
  isDecisionMaker  Boolean     @default(false)
  isBillingContact Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?
  version          Int         @default(1)

  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  portalUser  ClientPortalUser?
  invitations ClientInvitation[]

  @@index([clientId])
  @@index([organizationId])
  @@map("contacts")
}

enum ClientPortalRole {
  CLIENT_ADMIN
  CLIENT_MANAGER
  STAKEHOLDER
  APPROVER
  VIEWER
  BILLING_CONTACT
}

model ClientPortalUser {
  id             String           @id @default(cuid())
  organizationId String
  clientId       String
  contactId      String?          @unique
  email          String
  passwordHash   String
  role           ClientPortalRole @default(VIEWER)
  lastLoginAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact  Contact?              @relation(fields: [contactId], references: [id])
  sessions ClientPortalSession[]

  @@unique([clientId, email])
  @@index([organizationId])
  @@map("client_portal_users")
}

// A code-defined onboarding checklist (see packages/shared/src/onboarding.ts,
// same "catalog in code, instances in the DB" pattern as form templates) is
// instantiated into one row per step for a given client when onboarding
// starts. `key` is the stable identifier from that catalog — it's what lets
// a later catalog change not orphan already-instantiated rows.
enum OnboardingItemStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

model ClientOnboardingItem {
  id             String               @id @default(cuid())
  organizationId String
  clientId       String
  key            String
  title          String
  description    String?
  order          Int
  isRequired     Boolean              @default(true)
  status         OnboardingItemStatus @default(PENDING)
  completedAt    DateTime?
  completedById  String?
  relatedFormId  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  relatedForm Form?  @relation(fields: [relatedFormId], references: [id])

  @@unique([clientId, key])
  @@index([clientId])
  @@index([organizationId])
  @@map("client_onboarding_items")
}

// A portal invitation is a distinct flow from the staff Invitation model
// above: it targets a Client's contact (not an org member-to-be) and grants
// a ClientPortalRole (not an OrgRole). Reuses InvitationStatus since the
// lifecycle (pending/accepted/expired/revoked) is identical.
model ClientInvitation {
  id             String           @id @default(cuid())
  organizationId String
  clientId       String
  contactId      String?
  email          String
  role           ClientPortalRole @default(STAKEHOLDER)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact   Contact? @relation(fields: [contactId], references: [id])
  invitedBy User     @relation(fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([clientId])
  @@index([email])
  @@map("client_invitations")
}

model ClientPortalSession {
  id                 String    @id @default(cuid())
  clientPortalUserId String
  tokenHash          String    @unique
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?

  clientPortalUser ClientPortalUser @relation(fields: [clientPortalUserId], references: [id], onDelete: Cascade)

  @@index([clientPortalUserId])
  @@map("client_portal_sessions")
}

model ClientTimelineEvent {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  type           String
  title          String
  description    String?
  occurredAt     DateTime @default(now())
  metadata       Json?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt])
  @@map("client_timeline_events")
}

// ---------------------------------------------------------------------------
// Projects / delivery
// ---------------------------------------------------------------------------

// A reusable blueprint for standing up a new project in one step (e.g. a
// "Website Redesign" template with its usual phases/milestones/tasks).
// Each blueprint array holds plain JSON objects keyed by a stable `key`
// string (not a database id, since the template itself has no child rows)
// so phases/milestones/tasks can reference each other (a task's
// `milestoneKey`, a dependency's `dependsOnKeys`) before anything has been
// instantiated. See packages/shared/src/projectTemplates.ts for the exact
// shape and apps/api/src/projects/project-templates.service.ts for how
// `instantiate` resolves those keys into real Project/ProjectPhase/
// Milestone/Task rows. This is the same "catalog authored as data, not
// code" pattern as the Phase 2 form builder (`Form.isTemplate`).
model ProjectTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  phases         Json
  milestones     Json
  tasks          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([organizationId])
  @@map("project_templates")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id               String        @id @default(cuid())
  organizationId   String
  clientId         String
  name             String
  description      String?
  type             String?
  status           ProjectStatus @default(PLANNING)
  startDate        DateTime?
  targetEndDate    DateTime?
  actualEndDate    DateTime?
  contractValue    Decimal?      @db.Decimal(14, 2)
  budgetHours      Decimal?      @db.Decimal(10, 2)
  // Which ProjectTemplate this project was instantiated from, if any — same
  // "remember the origin, but never block on it existing" relationship as
  // Form.templateKey. SetNull (not Cascade) so deleting a template never
  // deletes the real projects created from it.
  sourceTemplateId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  version          Int           @default(1)

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceTemplate ProjectTemplate?       @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  phases         ProjectPhase[]
  milestones     Milestone[]
  tasks          Task[]
  deliverables   Deliverable[]
  assets         Asset[]
  forms          Form[]
  comments       Comment[]
  changeRequests ChangeRequest[]
  timeEntries    TimeEntry[]
  activityEvents ProjectActivityEvent[]

  @@index([organizationId])
  @@index([clientId])
  @@index([organizationId, status])
  @@map("projects")
}

enum ProjectMemberRole {
  LEAD
  CONTRIBUTOR
  OBSERVER
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(CONTRIBUTOR)
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectPhase {
  id        String    @id @default(cuid())
  projectId String
  name      String
  order     Int
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([projectId])
  @@map("project_phases")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  phaseId     String?
  name        String
  dueDate     DateTime?
  completedAt DateTime?
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id])
  tasks   Task[]

  @@index([projectId])
  @@map("milestones")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Visibility {
  INTERNAL
  CLIENT_VISIBLE
}

model Task {
  id                  String       @id @default(cuid())
  organizationId      String
  projectId           String
  milestoneId         String?
  deliverableId       String?
  parentTaskId        String?
  title               String
  description         String?
  status              TaskStatus   @default(TODO)
  priority            TaskPriority @default(MEDIUM)
  visibility          Visibility   @default(INTERNAL)
  assigneeId          String?
  startDate           DateTime?
  dueDate             DateTime?
  estimatedHours      Decimal?     @db.Decimal(8, 2)
  actualHours         Decimal?     @db.Decimal(8, 2)
  billable            Boolean      @default(true)
  // Orthogonal to `status` — a task can be IN_PROGRESS or BLOCKED *and*
  // waiting on the client for something (feedback, approval, content,
  // a decision) at the same time. Drives the project dashboard's
  // "waiting on client" list (see product.md Phase 3).
  waitingOnClient     Boolean      @default(false)
  waitingOnClientNote String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  version             Int          @default(1)

  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone        Milestone?       @relation(fields: [milestoneId], references: [id])
  deliverable      Deliverable?     @relation(fields: [deliverableId], references: [id])
  parentTask       Task?            @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subtasks         Task[]           @relation("TaskSubtasks")
  assignee         User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments         Comment[]
  timeEntries      TimeEntry[]
  dependenciesFrom TaskDependency[] @relation("DependentTask")
  dependenciesTo   TaskDependency[] @relation("BlockingTask")

  @@index([organizationId])
  @@index([projectId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model TaskDependency {
  id              String @id @default(cuid())
  dependentTaskId String
  blockingTaskId  String

  dependentTask Task @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  blockingTask  Task @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, blockingTaskId])
  @@map("task_dependencies")
}

enum DeliverableStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  DELIVERED
}

model Deliverable {
  id                 String            @id @default(cuid())
  organizationId     String
  projectId          String
  name               String
  description        String?
  status             DeliverableStatus @default(NOT_STARTED)
  acceptanceCriteria String?
  dueDate            DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  version            Int               @default(1)

  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks            Task[]
  requirementLinks DeliverableRequirement[]
  assets           Asset[]
  approvals        Approval[]

  @@index([projectId])
  @@map("deliverables")
}

// The requirement -> deliverable traceability spine (see product.md).
model DeliverableRequirement {
  id            String   @id @default(cuid())
  deliverableId String
  requirementId String
  createdAt     DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, requirementId])
  @@map("deliverable_requirements")
}

// An append-only feed of what happened on a project — real events written
// alongside the mutation that caused them (see ProjectActivityService), not
// derived/replayed from AuditLog after the fact, so it reads naturally
// ("Milestone X completed", "Task Y moved to Done") rather than as a raw
// diff. `type` is a stable machine string (e.g. "TASK_STATUS_CHANGED");
// `metadata` carries the specifics a UI needs to render that type's line.
model ProjectActivityEvent {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  type           String
  title          String
  description    String?
  actorUserId    String?
  actorContactId String?
  occurredAt     DateTime @default(now())
  metadata       Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, occurredAt])
  @@map("project_activity_events")
}

// ---------------------------------------------------------------------------
// Requirements engine (forms)
// ---------------------------------------------------------------------------

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  RICH_TEXT
  NUMBER
  CURRENCY
  DATE
  URL
  EMAIL
  PHONE
  SINGLE_SELECT
  MULTI_SELECT
  RATING
  RANKING
  FILE_UPLOAD
  IMAGE_UPLOAD
  VIDEO_UPLOAD
  ADDRESS
  CONSENT
  SIGNATURE
  CALCULATED
}

model Form {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String?
  projectId      String?
  templateKey    String?
  name           String
  description    String?
  // true = a reusable org-level template authored via the form builder
  // (POST /forms + /forms/:id/fields), stored as real rows rather than the
  // hardcoded FORM_TEMPLATES catalog — see docs/architecture.md. A template
  // Form has no clientId/projectId; instantiating it onto a project copies
  // its fields into a fresh non-template Form, same as the hardcoded
  // catalog's instantiateOnProject already does.
  isTemplate     Boolean  @default(false)
  // Snapshotted from the originating template (hardcoded or DB) at
  // instantiation time — evaluated at submit to auto-detect contradictory
  // answers (packages/shared/src/forms/readiness.ts). Living on the Form
  // instance, not re-read from the template, so editing a template later
  // never changes the rules an already-filled-in form is judged against.
  conflictRules  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client?                @relation(fields: [clientId], references: [id])
  project         Project?               @relation(fields: [projectId], references: [id])
  fields          FormField[]
  submissions     FormSubmission[]
  onboardingItems ClientOnboardingItem[]

  @@index([organizationId])
  @@map("forms")
}

// `conditionalRule` shape: { "field": "<fieldKey>", "operator": "equals" |
// "notEquals" | "in" | "notIn", "value": <any>, "combine"?: "AND" | "OR",
// "rules"?: ConditionalRule[] } — a small recursive tree evaluated client-
// and server-side by the same function (packages/shared/forms/evaluateRule.ts)
// so branching behaves identically wherever it runs.
model FormField {
  id              String        @id @default(cuid())
  formId          String
  key             String
  label           String
  helpText        String?
  type            FormFieldType
  required        Boolean       @default(false)
  order           Int
  options         Json?
  // MULTI_SELECT only — enforced by validateFieldValue (packages/shared)
  // at save time, not just descriptive metadata the renderer ignores.
  minSelections   Int?
  maxSelections   Int?
  conditionalRule Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  form      Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  responses FormResponse[]

  @@unique([formId, key])
  @@index([formId])
  @@map("form_fields")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
}

model FormSubmission {
  id                   String           @id @default(cuid())
  formId               String
  organizationId       String
  clientId             String?
  submittedByContactId String?
  submittedByUserId    String?
  status               SubmissionStatus @default(DRAFT)
  submittedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  form        Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  responses   FormResponse[]
  requirement Requirement?

  @@index([formId])
  @@index([organizationId])
  @@map("form_submissions")
}

// One row per field per submission — the immutable source-of-truth answer.
// A Requirement's `summary` may be edited by staff/AI later; these rows never
// are (see product.md §21/§56).
model FormResponse {
  id           String   @id @default(cuid())
  submissionId String
  fieldId      String
  valueText    String?
  valueJson    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission FormSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      FormField          @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  files      FormResponseFile[]

  @@unique([submissionId, fieldId])
  @@map("form_responses")
}

// One row per uploaded file for a FILE_UPLOAD/IMAGE_UPLOAD/VIDEO_UPLOAD
// response. `storageKey` is an opaque key into the StorageProvider — never
// served directly, same rule as AssetVersion (see security.md "File
// security"). A field can hold more than one file (e.g. several reference
// images), hence a separate table rather than a single column on FormResponse.
model FormResponseFile {
  id           String   @id @default(cuid())
  responseId   String
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String?
  createdAt    DateTime @default(now())

  response FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@map("form_response_files")
}

enum RequirementReadiness {
  MISSING
  NEEDS_CLARIFICATION
  READY
  CONFLICTING
}

model Requirement {
  id             String               @id @default(cuid())
  organizationId String
  projectId      String?
  submissionId   String               @unique
  title          String
  summary        String?
  readiness      RequirementReadiness @default(MISSING)
  missingFields  Json?
  conflicts      Json?
  reviewedById   String?
  reviewedAt     DateTime?
  // A reviewer's note explaining why they sent this back as
  // NEEDS_CLARIFICATION — distinct from `conflicts`, which is specific
  // field-pair contradictions rather than free-text reviewer feedback.
  reviewNote     String?
  version        Int                  @default(1)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  submission       FormSubmission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  deliverableLinks DeliverableRequirement[]
  versions         RequirementVersion[]

  @@index([organizationId])
  @@index([projectId])
  @@map("requirements")
}

// An immutable snapshot taken every time a Requirement's summary, readiness,
// or reviewer decision changes (first submit, review decision, resubmit
// after being reopened) — never edited once written, same "append-only
// history" principle as Approval. Lets staff see exactly what changed
// between versions rather than only the current state.
model RequirementVersion {
  id            String               @id @default(cuid())
  requirementId String
  version       Int
  summary       String?
  readiness     RequirementReadiness
  missingFields Json?
  conflicts     Json?
  changedById   String?
  changeNote    String?
  createdAt     DateTime             @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, version])
  @@index([requirementId])
  @@map("requirement_versions")
}

// ---------------------------------------------------------------------------
// Assets, comments, approvals, change requests
// ---------------------------------------------------------------------------

model Asset {
  id             String     @id @default(cuid())
  organizationId String
  projectId      String
  deliverableId  String?
  name           String
  visibility     Visibility @default(INTERNAL)
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable Deliverable?   @relation(fields: [deliverableId], references: [id])
  versions    AssetVersion[]

  @@index([projectId])
  @@map("assets")
}

// `storageKey` is an opaque key into the StorageProvider (see architecture.md
// "known gaps" — local-disk in dev, S3-compatible in production). It is never
// served directly; downloads always go through a signed-URL endpoint that
// re-checks authorization for this specific asset/version.
model AssetVersion {
  id            String   @id @default(cuid())
  assetId       String
  versionNumber Int
  label         String?
  storageKey    String
  mimeType      String
  sizeBytes     Int
  uploadedById  String
  createdAt     DateTime @default(now())

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@unique([assetId, versionNumber])
  @@map("asset_versions")
}

model Comment {
  id              String     @id @default(cuid())
  organizationId  String
  authorUserId    String?
  authorContactId String?
  visibility      Visibility @default(INTERNAL)
  body            String
  entityType      String
  entityId        String
  projectId       String?
  taskId          String?
  assetVersionId  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assetVersion AssetVersion? @relation(fields: [assetVersionId], references: [id], onDelete: Cascade)
  author       User?         @relation(fields: [authorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([organizationId])
  @@map("comments")
}

enum ApprovalStatus {
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  APPROVED_WITH_CONDITIONS
  REJECTED
}

// Immutable history: each decision is a new row, never edited (product.md §30).
model Approval {
  id                 String         @id @default(cuid())
  organizationId     String
  deliverableId      String
  version            Int
  status             ApprovalStatus
  decidedById        String?
  decidedByContactId String?
  comments           String?
  createdAt          DateTime       @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  decidedBy   User?       @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([deliverableId])
  @@map("approvals")
}

enum ChangeRequestStatus {
  DRAFT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  APPROVED
  REJECTED
  APPLIED
}

model ChangeRequest {
  id                   String              @id @default(cuid())
  organizationId       String
  projectId            String
  title                String
  description          String
  reason               String?
  impact               String?
  estimatedEffortHours Decimal?            @db.Decimal(8, 2)
  estimatedCost        Decimal?            @db.Decimal(12, 2)
  timelineImpactDays   Int?
  status               ChangeRequestStatus @default(DRAFT)
  requestedById        String?
  requestedByContactId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("change_requests")
}

// ---------------------------------------------------------------------------
// Notifications, audit, CSAT, time tracking
// ---------------------------------------------------------------------------

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String?
  entityType     String?
  entityId       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// Every email the app attempts to send is recorded here regardless of which
// EmailProvider handled it (apps/api/src/email) — the console/dev provider
// writes this as its only real effect, and the SMTP provider writes it
// alongside actually sending, so delivery is inspectable/testable either way
// without depending on a real inbox existing in every environment.
model EmailLog {
  id             String   @id @default(cuid())
  organizationId String?
  to             String
  subject        String
  template       String
  metadata       Json?
  provider       String
  sentAt         DateTime @default(now())

  @@index([organizationId])
  @@index([to])
  @@map("email_logs")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  entityType     String
  entityId       String
  action         String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model CSAT {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  projectId      String?
  rating         Int
  comment        String?
  stage          String
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("csat_responses")
}

model TimeEntry {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  taskId         String?
  userId         String
  minutes        Int
  billable       Boolean  @default(true)
  note           String?
  occurredOn     DateTime
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@map("time_entries")
}
