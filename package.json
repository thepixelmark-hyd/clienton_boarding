{
  "name": "clientos",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev:web": "pnpm --filter @clientos/web dev",
    "dev:api": "pnpm --filter @clientos/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @clientos/database generate",
    "db:migrate": "pnpm --filter @clientos/database migrate",
    "db:migrate:deploy": "pnpm --filter @clientos/database migrate:deploy",
    "db:seed": "pnpm --filter @clientos/database seed"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "prettier": "3.3.3"
  }
}
